{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Room",
  "version": "0.1.0",
  "identifier": "local.agent-room.desktop",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Room", "width": 600, "height": 450, "minWidth": 480, "minHeight": 400 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
